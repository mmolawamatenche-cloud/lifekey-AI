# Optional public base URL for an AI service implementing POST /api/chat.
# Copy this file to .env.local and replace the value with your service URL.
# The service must allow browser requests from LIFEKEY's origin (CORS).
# Do not put API keys or other secrets in this variable.
LIFEKEY_AI_URL=

# Optional JSONL audit log for approval requests/decisions/consumption.
# Logs action names and summaries only; private parameters are never written.
# Leave blank to disable.
LIFEKEY_APPROVAL_LOG_PATH=
